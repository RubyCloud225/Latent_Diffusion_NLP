tests/experimental/test_clifford_projection.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_clifford_projection.dir/build.make CMakeFiles/test_clifford_projection.dir/tests/experimental/test_clifford_projection.cpp.i
.PHONY : tests/experimental/test_clifford_projection.cpp.i

tests/experimental/test_clifford_projection.s: tests/experimental/test_clifford_projection.cpp.s
.PHONY : tests/experimental/test_clifford_projection.s

# target to generate assembly for a file
tests/experimental/test_clifford_projection.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/test_clifford_projection.dir/build.make CMakeFiles/test_clifford_projection.dir/tests/experimental/test_clifford_projection.cpp.s
.PHONY : tests/experimental/test_clifford_projection.cpp.s

